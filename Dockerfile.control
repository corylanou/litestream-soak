FROM golang:1.26.9-bookworm@sha256:bcef992b77b1e2031aaaa51da75cebc32da8e9c182e12e633ea79023c79d9eff AS builder
ENV GOTOOLCHAIN=local
RUN go version
WORKDIR /src/soak
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags "-s -w" -o /usr/local/bin/soakctl ./cmd/soakctl
RUN go version -m /usr/local/bin/soakctl >/tmp/soakctl.buildinfo && cat /tmp/soakctl.buildinfo

FROM golang:1.26.9-bookworm@sha256:bcef992b77b1e2031aaaa51da75cebc32da8e9c182e12e633ea79023c79d9eff AS flyctl
ENV GOTOOLCHAIN=local
COPY scripts/build-flyctl.sh /opt/build/
RUN bash /opt/build/build-flyctl.sh /src/flyctl /usr/local/bin/flyctl
RUN go version -m /usr/local/bin/flyctl && mkdir -p /tmp/security/flyctl && \
    cp /usr/local/bin/flyctl.* /tmp/security/flyctl/

FROM debian:bookworm-slim@sha256:0104b334637a5f19aa9c983a91b54c89887c0984081f2068983107a6f6c21eeb
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl iproute2 jq lsof procps sqlite3 util-linux && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 10001 soak && \
    useradd --system --uid 10001 --gid soak --home-dir /data --shell /usr/sbin/nologin soak && \
    mkdir -p /data && \
    chown soak:soak /data
COPY --from=flyctl /usr/local/bin/flyctl /usr/local/bin/flyctl
COPY --from=builder /usr/local/bin/soakctl /usr/local/bin/soakctl
COPY --from=builder /tmp/soakctl.buildinfo /opt/soak/soakctl.buildinfo
COPY --from=flyctl /usr/local/bin/flyctl.buildinfo /opt/soak/flyctl.buildinfo
COPY --from=flyctl /tmp/security /opt/soak/security
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod 0755 /usr/local/bin/docker-entrypoint
ENV SOAK_DATA_DB=/data/soakctl.db
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]
CMD ["/usr/local/bin/soakctl"]
