ARG LITESTREAM_SHA=main
ARG LITESTREAM_BASE_SHA=
ARG WORKLOAD_SHA=ae88b164dd6304bcbb654a681df767ee59042eed

# Stage 1: Build litestream + litestream-test from source
FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS litestream-builder
ENV GOTOOLCHAIN=local
RUN go version
ARG LITESTREAM_SHA
WORKDIR /src/litestream
RUN git clone https://github.com/benbjohnson/litestream.git . && \
    git fetch origin "${LITESTREAM_SHA}" && \
    git checkout --detach "${LITESTREAM_SHA}" && \
    git rev-parse HEAD >/tmp/litestream.sha
RUN go build \
    -ldflags "-s -w -X 'main.Version=${LITESTREAM_SHA}'" \
    -tags osusergo,netgo,sqlite_omit_load_extension \
    -o /usr/local/bin/litestream ./cmd/litestream
RUN go version -m /usr/local/bin/litestream >/tmp/litestream.buildinfo && cat /tmp/litestream.buildinfo
# The SQLite loadable VFS extension from the same checkout, built the way the
# upstream Dockerfile and Makefile build it: a cgo c-archive linked into a
# shared object with the vendored sqlite3ext.h entry point.
RUN CGO_ENABLED=1 go build \
    -tags vfs,SQLITE3VFS_LOADABLE_EXT \
    -buildmode=c-archive \
    -o /tmp/litestream-vfs.a ./cmd/litestream-vfs && \
    cp /tmp/litestream-vfs.h src/litestream-vfs.h && \
    gcc -DSQLITE3VFS_LOADABLE_EXT -g -fPIC -shared \
    -o /usr/local/lib/litestream-vfs.so \
    src/litestream-vfs.c /tmp/litestream-vfs.a -lpthread -ldl -lm && \
    { echo "litestream-vfs.so"; echo "	litestream	$(cat /tmp/litestream.sha)"; echo "	$(go version)"; } >/tmp/litestream-vfs.buildinfo && cat /tmp/litestream-vfs.buildinfo

# Stage 1b: Optional second litestream build for the upgrade gate lane. With an
# empty LITESTREAM_BASE_SHA the stage produces an empty /out and the runtime
# image carries only the pinned build.
FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS litestream-base-builder
ENV GOTOOLCHAIN=local
ARG LITESTREAM_BASE_SHA
WORKDIR /src/litestream-base
RUN mkdir -p /out && \
    if [ -n "${LITESTREAM_BASE_SHA}" ]; then \
      git clone https://github.com/benbjohnson/litestream.git . && \
      git fetch origin "${LITESTREAM_BASE_SHA}" && \
      git checkout --detach "${LITESTREAM_BASE_SHA}" && \
      git rev-parse HEAD >/out/litestream-base.sha && \
      go build \
        -ldflags "-s -w -X 'main.Version=${LITESTREAM_BASE_SHA}'" \
        -tags osusergo,netgo,sqlite_omit_load_extension \
        -o /out/litestream-base ./cmd/litestream && \
      go version -m /out/litestream-base >/out/litestream-base.buildinfo && cat /out/litestream-base.buildinfo; \
    fi
FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS workload-builder
ENV GOTOOLCHAIN=local
RUN go version
ARG WORKLOAD_SHA
WORKDIR /src/litestream
RUN git clone https://github.com/benbjohnson/litestream.git . && \
    git checkout --detach "${WORKLOAD_SHA}" && \
    test "$(git rev-parse HEAD)" = "${WORKLOAD_SHA}"
RUN CGO_CFLAGS="-DSQLITE_DEFAULT_WAL_AUTOCHECKPOINT=0" go build \
    -ldflags "-s -w -X 'main.Version=${WORKLOAD_SHA}'" \
    -o /usr/local/bin/litestream-test ./cmd/litestream-test
RUN go version -m /usr/local/bin/litestream-test >/tmp/litestream-test.buildinfo && cat /tmp/litestream-test.buildinfo
# The load binary above disables SQLite's automatic WAL checkpoint so that
# Litestream owns checkpointing in steady state. The initial populate runs
# before Litestream exists, so it uses this second build of the same pinned
# source with SQLite's default autocheckpoint, which bounds the WAL inside
# populate's own connection with no second writer.
RUN go build \
    -ldflags "-s -w -X 'main.Version=${WORKLOAD_SHA}'" \
    -o /usr/local/bin/litestream-test-populate ./cmd/litestream-test
RUN go version -m /usr/local/bin/litestream-test-populate >/tmp/litestream-test-populate.buildinfo && cat /tmp/litestream-test-populate.buildinfo

# Stage 2: Build soakworker
FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS soakworker-builder
ENV GOTOOLCHAIN=local
RUN go version
WORKDIR /src/soak
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags "-s -w" -o /usr/local/bin/soakworker ./cmd/soakworker
RUN go version -m /usr/local/bin/soakworker >/tmp/soakworker.buildinfo && cat /tmp/soakworker.buildinfo

# Stage 3: Runtime image
FROM debian:bookworm-slim@sha256:0104b334637a5f19aa9c983a91b54c89887c0984081f2068983107a6f6c21eeb
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      dnsutils \
      file \
      iproute2 \
      jq \
      lsof \
      netcat-openbsd \
      procps \
      ripgrep \
      s3cmd \
      strace \
      time \
      sqlite3 \
      util-linux && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 10001 soak && \
    useradd --system --uid 10001 --gid soak --home-dir /data --shell /usr/sbin/nologin soak && \
    mkdir -p /data && \
    chown soak:soak /data
COPY --from=litestream-builder /usr/local/bin/litestream /usr/local/bin/litestream
COPY --from=litestream-builder /usr/local/lib/litestream-vfs.so /usr/local/lib/litestream-vfs.so
# The extension must load, and a .open of a vfs=litestream URI issued after
# .load must reach the extension's VFS: the shell opens a database named on the
# command line before .load registers the VFS, which is the failure this guards.
# Without a replica URL the VFS refuses the open with a plain Go error, which
# sqlite3vfs reports as SQLITE_ERROR ("SQL logic error"); the shell then falls
# back to an in-memory database and exits 0. Only that exact outcome passes: a
# timeout, any other exit status, "no such vfs", or a different error fails.
RUN sqlite3 :memory: ".load /usr/local/lib/litestream-vfs.so" "SELECT 'vfs extension loads'" && \
    uri='file:/tmp/vfs-check.db?vfs=litestream&mode=ro' && \
    output="$(printf 'SELECT 1;\n' | timeout 60 sqlite3 -batch -list -noheader -cmd ".load /usr/local/lib/litestream-vfs.so" -cmd ".open \"${uri}\"" 2>&1)"; status=$?; \
    echo "${output}"; \
    case "${output}" in *"no such vfs"*) echo "litestream vfs not registered before .open" >&2; exit 1;; esac; \
    if [ "${status}" -eq 124 ]; then echo "vfs open check timed out" >&2; exit 1; fi; \
    if [ "${status}" -ne 0 ]; then echo "vfs open check exited ${status}" >&2; exit 1; fi; \
    case "${output}" in *"Error: unable to open database \"${uri}\": SQL logic error"*) ;; *) echo "vfs open check did not report the missing-replica error" >&2; exit 1;; esac
COPY --from=workload-builder /usr/local/bin/litestream-test /usr/local/bin/litestream-test
COPY --from=workload-builder /usr/local/bin/litestream-test-populate /usr/local/bin/litestream-test-populate
COPY --from=litestream-builder /tmp/litestream.sha /opt/soak/litestream.sha
COPY --from=litestream-base-builder /out/ /opt/soak/base/
COPY --from=soakworker-builder /usr/local/bin/soakworker /usr/local/bin/soakworker
COPY --from=soakworker-builder /src/soak/datasets /opt/soak/datasets
COPY --from=litestream-builder /tmp/litestream.buildinfo /opt/soak/litestream.buildinfo
COPY --from=litestream-builder /tmp/litestream-vfs.buildinfo /opt/soak/litestream-vfs.buildinfo
COPY --from=workload-builder /tmp/litestream-test.buildinfo /opt/soak/litestream-test.buildinfo
COPY --from=workload-builder /tmp/litestream-test-populate.buildinfo /opt/soak/litestream-test-populate.buildinfo
COPY --from=soakworker-builder /tmp/soakworker.buildinfo /opt/soak/soakworker.buildinfo
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod 0755 /usr/local/bin/docker-entrypoint
ARG WORKLOAD_SHA
ENV WORKLOAD_SHA=${WORKLOAD_SHA}
ENV LITESTREAM_SHA_FILE=/opt/soak/litestream.sha
ENV LITESTREAM_VFS_EXTENSION=/usr/local/lib/litestream-vfs.so
ENV LITESTREAM_BASE_BINARY=/opt/soak/base/litestream-base
ENV LITESTREAM_BASE_SHA_FILE=/opt/soak/base/litestream-base.sha
ENV SOAK_DATA_DB=/data/test.db
VOLUME /data
EXPOSE 9091
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]
CMD ["/usr/local/bin/soakworker"]
